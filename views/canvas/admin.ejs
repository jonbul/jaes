<% layout('layout') %>

  <div class="form-register" id="form-register">
    <h1 class="h3 mb-3 font-weight-normal">Administration panel</h1>

    <div class="form-group">
      <label for="resolution" class="">Resolution</label>
      <select type="text" id="resolution" class="form-control" required="true" autofocus="true" name="resolution" value="">

      </select>
    </div>

    <div class="form-group">
      <label for="allowedPlayerType" class="">Players allowed</label>
      <select type="text" id="allowedPlayerType" class="form-control" required="true" name="allowedPlayerType">

      </select>
    </div>

    <button class="btn btn-lg btn-primary btn-block" type="button" id="save">Save</button>
    <iframe src="/status" style="width:100%; height: 1030px; border: solid 1px #ccc; margin-top:20px;"></iframe>
  </div>

  <script type="module" src="/js/canvas/admin.js"></script>